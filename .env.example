# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mutualaid
DATABASE_URL=postgresql://postgres:postgres@db:5432/mutualaid

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://localhost:3000"]

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
ALGORITHM=HS256

# Email (configure these in production)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAILS_FROM_EMAIL=noreply@mutualaid.example.com
EMAILS_FROM_NAME="MutualAid"

# Frontend
VITE_API_URL=/api
VITE_APP_NAME=MutualAid
